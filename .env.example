# Copy this file to .env and adjust values locally.
# Never commit .env or real secrets.

# Application
EVENT_APP_ENV=local
EVENT_SERVICE_NAME=event-management-api
EVENT_APP_VERSION=0.1.0
EVENT_API_VERSION=v1
EVENT_DOCS_ENABLED=true

# Logging
EVENT_LOG_LEVEL=INFO
EVENT_LOG_FORMAT=json

# CORS: comma-separated origins. Leave empty to disable cross-origin access.
EVENT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database: use the Supabase session pooler or direct PostgreSQL connection.
# Credentials must come from your secret manager / local .env, never source control.
EVENT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
EVENT_DB_POOL_SIZE=5
EVENT_DB_MAX_OVERFLOW=10
EVENT_DB_POOL_TIMEOUT_SECONDS=30
EVENT_DB_POOL_RECYCLE_SECONDS=1800
EVENT_DB_STATEMENT_TIMEOUT_MS=30000
EVENT_DB_PREPARE_THRESHOLD=0
EVENT_DB_ECHO=false

# Webhook HMAC (JSON object of key ID -> shared secret). Rotate by adding v2,
# then remove v1 after all senders have switched.
# EVENT_WEBHOOK_SIGNING_KEYS={"v1":"replace-with-long-random-secret","v2":"replace-when-rotating"}
# EVENT_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Supabase JWT verification
# EVENT_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EVENT_SUPABASE_JWT_STRATEGY=hs256
# EVENT_SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
# EVENT_SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# EVENT_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# EVENT_JWT_AUDIENCE=authenticated
# EVENT_JWT_LEEWAY_SECONDS=0

# Shared rate limiting (PostgreSQL-backed; no Redis required)
# EVENT_RATE_LIMIT_WINDOW_SECONDS=60
# EVENT_WEBHOOK_RATE_LIMIT=60
# EVENT_CHECKIN_VERIFY_RATE_LIMIT=120
# EVENT_CHECKIN_CONFIRM_RATE_LIMIT=60
# EVENT_ADMIN_EXPORT_RATE_LIMIT=10
# EVENT_ADMIN_ROSTER_IMPORT_RATE_LIMIT=5

# Event-scoped first-year eligibility roster imports
# EVENT_ROSTER_IMPORT_MAX_UPLOAD_BYTES=1048576
# EVENT_ROSTER_IMPORT_MAX_ROWS=1000

# Ticket credentials (must be a long random value outside local/test)
# EVENT_TICKET_TOKEN_DERIVATION_KEY=replace-with-32-plus-character-random-secret

# Resend ticket email delivery
# EVENT_RESEND_API_KEY=re_replace_with_resend_api_key
# EVENT_RESEND_FROM_EMAIL=tickets@your-verified-domain.example
# EVENT_RESEND_FROM_NAME=Event Management

# Email worker
# EVENT_EMAIL_WORKER_POLL_INTERVAL_SECONDS=5
# EVENT_EMAIL_WORKER_BATCH_SIZE=10
# EVENT_EMAIL_WORKER_MAX_ATTEMPTS=5
# EVENT_EMAIL_WORKER_LEASE_SECONDS=60
# EVENT_EMAIL_RETRY_BACKOFF_INITIAL_SECONDS=30
# EVENT_EMAIL_RETRY_BACKOFF_MULTIPLIER=2
# EVENT_EMAIL_RETRY_BACKOFF_MAX_SECONDS=3600
